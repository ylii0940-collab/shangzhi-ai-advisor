# 复制本文件为 .env，然后填入你的 OpenAI API Key。
# 密钥只会由 Python 后端读取，不会发送到前端页面。
OPENAI_API_KEY=

# 成本优先的默认模型；可按账号权限替换。
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low

# auto: 有 Key 时调用真实模型，无 Key 时运行可演示的离线推理。
# live: 必须调用真实模型，调用失败会返回错误。
# demo: 始终使用离线推理，适合无网络演示。
SHANGZHI_AGENT_MODE=auto

SHANGZHI_HOST=127.0.0.1
SHANGZHI_PORT=8000
SHANGZHI_DB_PATH=data/shangzhi.db
SHANGZHI_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://shangzhi-ai-advisor.aft15679ty.chatgpt.site

# 可选：接入 LangSmith 后自动记录模型调用链路。
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=shangzhi-ai-advisor
